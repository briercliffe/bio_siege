{
  "compilerOptions": {
    "target": "ES2015",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noImplicitAny": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "types": ["nakama-runtime", "node"],
    "lib": ["ES2015"],
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
